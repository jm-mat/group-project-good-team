# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored, so the camera password is never committed.

# Tapo C200 IP address. Find it in the Tapo app: Camera -> Settings ->
# Device Info, or in your router's client list. Reserve it in the router
# (DHCP reservation) so it doesn't change.
TAPO_IP=

# The *Camera Account* created in the Tapo app under
# Camera -> Settings -> Advanced Settings -> Camera Account.
# This is NOT your TP-Link cloud login.
TAPO_USERNAME=
TAPO_PASSWORD=

# Optional: stream1 = full quality (1080p), stream2 = low quality (~360p).
# Each script picks a sensible default, so this is usually left blank.
# TAPO_STREAM=stream1

# Optional: full RTSP URL; overrides everything above.
# TAPO_RTSP_URL=rtsp://user:pass@192.168.1.50:554/stream1
